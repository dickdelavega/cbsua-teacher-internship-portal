{
  "name": "internship-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-database-provider.js && prisma generate && next dev --webpack",
    "build": "node scripts/sync-database-provider.js && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/sync-database-provider.js && prisma generate",
    "db:push": "node scripts/sync-database-provider.js && prisma db push",
    "db:seed": "node scripts/sync-database-provider.js && prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "lucide-react": "^1.54.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines": true,
    "@prisma/engines@5.22.0": true,
    "prisma": true,
    "prisma@5.22.0": true,
    "unrs-resolver": true,
    "unrs-resolver@1.12.2": true
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "fsevents",
      "prisma",
      "unrs-resolver"
    ]
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "fsevents",
    "prisma",
    "unrs-resolver"
  ]
}
